---
const email = 'tp9imka@gmail.com';
const refusals = [
  ['Push after approval', 'Verdicts bound to the old head go VOID. No receipt for the new head => gate shut.'],
  ['Skip QA', 'No QA receipt for the head => the merge guard refuses.'],
  ['Edit the guard', 'The guard cannot read the checks => fail closed.'],
  ['Retry until green', 'Same check red on 3 heads => the driver parks it and re-plans.'],
];
---
<section class="hero" id="hero" aria-labelledby="hero-h1">
  <span class="simtag hero-sim">SIMULATION</span>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Ivan Antsimonau · principal engineer, agentic systems</p>
      <h1 id="hero-h1" class="hero-h1 struck">Go on.<br />Try to <span class="m">merge.</span></h1>
      <p class="hero-sub">I lead agent crews that ship on their own, and I build the gates that tell them no. <b>You play the agent that cuts corners.</b> The gates are the ones I run on real work.</p>
      <div class="ctas">
        <a class="btn primary" href="/cv.pdf">Download CV</a>
        <span class="email"><span id="hero-email" class="mono">{email}</span><button type="button" class="btn ghost js-only" data-copy={email} data-copy-target="hero-email">Copy email</button></span>
      </div>
      <p class="ticker mono" id="hero-ticker">sweep 10:40 · no LLM</p>
      <div class="play js-only" id="hero-play" data-on="0">
        <p class="play-k mono">Your move. Try to get it merged:</p>
        <div class="play-row">
          <button type="button" data-attempt="push">Push after approval</button>
          <button type="button" data-attempt="skip-qa">Skip QA</button>
          <button type="button" data-attempt="edit-guard">Edit the guard</button>
          <button type="button" data-attempt="retry">Retry until green</button>
        </div>
        <p class="score mono" aria-live="polite">Attempts <b id="attempts">0</b> · Merged <b>0</b></p>
      </div>
      <ul class="no-js refusal-list">
        {refusals.map(([a, r]) => <li><b>{a}:</b> {r}</li>)}
      </ul>
    </div>
    <div class="pr" id="pr-card" aria-live="polite">
      <div class="pr-top mono"><span>PR #412 · crew board</span><span id="pr-headwrap">head <b id="pr-head">7be204</b></span></div>
      <p class="pr-title">fix: session restore drops drafts</p>
      <div class="chips mono">
        <span class="chip ok" id="chip-ci">CI green</span>
        <span class="chip void" id="chip-review">Review PASS @a3f9c1</span>
        <span class="chip void" id="chip-qa">QA PASS @a3f9c1</span>
      </div>
      <p class="guard mono" id="guard">merge guard: all checks green => allow</p>
      <div class="merge shut" id="merge">REFUSED</div>
      <p class="refusal mono" id="refusal">VOID: verdicts were for a3f9c1, head is 7be204. No receipt for the head => gate shut.</p>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero/hero';
  import { initCopyButtons } from '../scripts/copy';
  initHero();
  initCopyButtons(document.getElementById('hero') ?? document);
</script>

<style is:global>
  .hero { position: relative; overflow: hidden; padding-block: 56px 72px; }
  .hero-sim { position: absolute; top: 14px; right: var(--gutter-r); color: var(--muted); z-index: 4; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero-h1 { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: clamp(3.6rem, 11vw, 9.6rem); line-height: 0.86; letter-spacing: -0.01em; margin-top: 14px; }
  .hero-h1 .m { position: relative; display: inline-block; }
  .hero-h1 .m::after { content: ""; position: absolute; left: -2%; top: 52%; height: 0.11em; width: 0; background: var(--red); transition: width .18s steps(3); }
  .hero-h1.struck .m::after { width: 104%; }
  .hero-sub { font-size: 1.12rem; max-width: 46ch; margin-top: 22px; color: var(--muted); }
  .hero-sub b { color: var(--fg); font-weight: 600; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; margin-top: 26px; }
  .email { display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap; font-size: 0.9rem; }
  .ticker { font-size: 0.75rem; color: var(--faint); margin-top: 22px; }
  .play { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
  html.js .play[data-on="0"] { visibility: hidden; }
  .play-k { font-size: 0.78rem; color: var(--muted); }
  .play-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .play-row button { font-family: var(--mono); font-size: 0.82rem; background: transparent; color: var(--yellow); border: 1px solid var(--yellow); padding: 8px 12px; min-height: 44px; cursor: pointer; }
  .play-row button:hover { background: var(--yellow); color: var(--on-yellow); }
  .score { font-size: 0.85rem; }
  .score b { color: var(--red); }
  .refusal-list { margin: 22px 0 0; padding-left: 1.1em; color: var(--muted); display: flex; flex-direction: column; gap: 6px; font-size: 0.95rem; }
  .refusal-list b { color: var(--fg); }
  .pr { border: 1px solid var(--line); background: var(--surface); padding: 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; margin-top: 24px; }
  .pr-top { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 0.78rem; color: var(--muted); }
  .pr-top b { color: var(--yellow); }
  .pr-title { font-weight: 600; font-size: 1.15rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 0.78rem; padding: 5px 9px; border: 1px solid var(--line); }
  .chip.ok { border-color: var(--green); color: var(--green); }
  .chip.bad { border-color: var(--red); color: var(--red); }
  .chip.void { color: var(--faint); text-decoration: line-through; border-style: dashed; }
  .guard { font-size: 0.78rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 10px; }
  .guard.bad { color: var(--red); }
  .merge { font-family: var(--display); font-weight: 900; font-size: 2.1rem; letter-spacing: .04em; padding: 10px 14px; text-align: center; background: var(--green); color: var(--on-green); }
  .merge.shut { background: repeating-linear-gradient(-45deg, var(--red) 0 14px, var(--red-deep) 14px 28px); color: #F4F1EA; text-shadow: 0 1px 0 #0B0B0C; }
  .refusal { font-size: 0.8rem; color: var(--red); min-height: 2.8em; }
  .flash { animation: flash .12s steps(1) 2; }
  @keyframes flash { 50% { background: var(--red); color: var(--bg); } }
  .shake { animation: shake .1s steps(2) 2; }
  @keyframes shake { 0% { transform: translateX(-4px); } 100% { transform: translateX(4px); } }
  .cur { position: absolute; left: 0; top: 0; width: 0; height: 0; z-index: 5; pointer-events: none; transition: transform 0.75s cubic-bezier(.2,.8,.2,1); will-change: transform; display: none; }
  .hero.live .cur { display: block; }
  .cur svg { position: absolute; left: -2px; top: -2px; width: 20px; height: 24px; transition: transform .12s; }
  .cur .cur-lbl { position: absolute; left: 16px; top: 18px; white-space: nowrap; font-family: var(--mono); font-size: 0.7rem; font-weight: 600; padding: 3px 8px; }
  .cur.press svg { transform: scale(.82); }
  @media (max-width: 520px) { .cur .cur-lbl { font-size: 0.62rem; } }
</style>
