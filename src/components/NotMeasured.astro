---
import { publishedEvidence } from '../data/evidence';
const owed = publishedEvidence('owed');
---
<section class="section" aria-labelledby="owed-h">
  <div class="wrap">
    <p class="eyebrow">Not measured yet</p>
    <h2 id="owed-h" class="h2">The numbers I still owe.</h2>
    <p class="lede">Agent counts and commit counts are easy and say little. These are the ones that matter, and they are not collected yet. They will land here with their denominators.</p>
    <ul class="owed">
      {owed.map((e) => <li><span class="mono owed-l">{e.label}</span><span class="owed-c">{e.counts}</span></li>)}
    </ul>
  </div>
</section>
<style>
  .owed { list-style: none; padding: 0; margin: 28px 0 0; border-top: 1px dashed var(--line); }
  .owed li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 8px 24px; padding: 14px 0; border-bottom: 1px dashed var(--line); }
  @media (max-width: 700px) { .owed li { grid-template-columns: minmax(0, 1fr); } }
  .owed-l { color: var(--yellow); font-size: 0.85rem; }
  .owed-c { color: var(--muted); }
</style>
