---
import { publishedEvidence } from '../data/evidence';
const items = publishedEvidence('oss');
---
<section class="section" id="open-source" aria-labelledby="oss-h">
  <div class="wrap">
    <p class="eyebrow">Open source</p>
    <h2 id="oss-h" class="h2">Things you can install and check.</h2>
    <div class="oss-install mono"><span class="k">$</span> farmout run auto --kind review --brief review.md <span class="c"># routes the job to another agent CLI</span></div>
    <ul class="oss">
      {items.map((e) => (
        <li>
          <a href={e.url} class="oss-name mono">{e.value} =></a>
          <span class="oss-l">{e.label}</span>
          <span class="oss-c">{e.counts}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .oss-install { margin-top: 32px; border: 1px solid var(--line); background: var(--surface); padding: 14px 16px; font-size: 0.85rem; overflow-x: auto; white-space: nowrap; }
  .oss-install .k { color: var(--yellow); }
  .oss-install .c { color: var(--faint); }
  .oss { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .oss li { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr) minmax(0, 1.4fr); gap: 8px 24px; padding: 16px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  @media (max-width: 760px) { .oss li { grid-template-columns: minmax(0, 1fr); } }
  .oss-name { color: var(--yellow); text-decoration: none; font-weight: 600; }
  .oss-name:hover { text-decoration: underline; }
  .oss-l { color: var(--fg); }
  .oss-c { color: var(--muted); font-size: 0.92rem; }
</style>
