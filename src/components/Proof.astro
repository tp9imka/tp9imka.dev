---
import { publishedEvidence } from '../data/evidence';
const items = publishedEvidence('proof');
---
<section class="proof" aria-label="Proof">
  <div class="wrap proof-grid">
    {items.map((e) => (
      <div class="pc"><span class="pv">{e.value}</span><span class="pl">{e.label}</span><span class="pn">{e.counts}</span></div>
    ))}
  </div>
  <p class="wrap owed mono">Cost per merged PR: not measured yet.</p>
</section>
<style>
  .proof { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--panel); padding-block: 4px 14px; }
  .proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .pc { padding: 24px 18px 12px 0; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pv { font-family: var(--display); font-weight: 900; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1; text-transform: uppercase; color: var(--green); font-variant-numeric: tabular-nums; }
  .pl { font-family: var(--mono); font-size: .8rem; color: var(--fg); }
  .pn { font-size: .85rem; color: var(--muted); }
  .owed { font-size: .75rem; color: var(--yellow); margin-top: 4px; }
</style>
