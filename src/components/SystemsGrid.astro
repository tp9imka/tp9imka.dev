---
import { getCollection } from 'astro:content';
const systems = (await getCollection('systems', (s) => s.data.published)).sort((a, b) => a.data.order - b.data.order);
---
<section class="section" id="systems" aria-labelledby="sys-h">
  <div class="wrap">
    <p class="eyebrow">Systems I built and run</p>
    <h2 id="sys-h" class="h2">The same harness at work, in my product, and at home.</h2>
    <div class="sys-grid">
      {systems.map((s) => (
        <a class="sys" href={`/systems/${s.id}/`}>
          <span class="sys-tag mono">{s.data.tag}</span>
          <span class="sys-t">{s.data.title}</span>
          <span class="sys-s">{s.data.summary}</span>
          <span class="sys-go mono">Read how it works =></span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .sys-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 40px; }
  .sys { background: var(--bg); padding: 24px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; min-width: 0; transition: background .15s; }
  .sys:hover { background: var(--surface); }
  .sys-tag { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--yellow); }
  .sys-t { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: 1.9rem; line-height: 0.95; }
  .sys-s { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .sys-go { font-size: 0.78rem; color: var(--fg); }
</style>
