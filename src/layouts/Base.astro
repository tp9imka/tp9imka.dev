---
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-900';
import '@fontsource/jetbrains-mono/latin-400';
import '@fontsource/jetbrains-mono/latin-600';
import '@fontsource/jetbrains-mono/latin-700';
import '@fontsource/inter-tight/latin-400';
import '@fontsource/inter-tight/latin-500';
import '@fontsource/inter-tight/latin-600';
import '@fontsource/inter-tight/latin-700';
import '@fontsource/silkscreen/latin-400';
import '@fontsource/silkscreen/latin-700';
import '../styles/global.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme-boot.js"></script>
  </head>
  <body>
    <header class="strip">
      <div class="wrap strip-in">
        <a class="mark" href="/">tp9imka</a>
        <span class="held mono" aria-live="polite">gates held <b data-gates>0</b></span>
        <span class="right">
          <a class="cv" href="/cv.pdf">CV</a>
          <button type="button" class="mail" data-copy="tp9imka@gmail.com">tp9imka@gmail.com</button>
          <button type="button" id="theme-toggle" class="js-only" aria-label="Switch theme">light</button>
        </span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <span class="mono">tp9imka · Abu Dhabi · 2026</span>
        <span class="mono">Screens marked SIMULATION or REPLAY animate real mechanisms with sample data.</span>
        <a class="mono" href="https://pub.dev/publishers/tp9imka.dev/packages">pub.dev verified publisher</a>
      </div>
    </footer>
    <script>
      import { initThemeToggle } from '../scripts/theme';
      import { initCopyButtons } from '../scripts/copy';
      import { pageCounter } from '../scripts/gates-counter';
      initThemeToggle();
      initCopyButtons(document.querySelector('.strip') ?? document);
      pageCounter().subscribe((n) => document.querySelectorAll('[data-gates]').forEach((e) => { e.textContent = String(n); }));
    </script>
  </body>
</html>

<style>
  .strip { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 40; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .strip-in { display: flex; align-items: center; gap: 12px 22px; min-height: 44px; flex-wrap: wrap; font-family: var(--mono); font-size: 0.78rem; }
  .mark { text-decoration: none; font-weight: 700; }
  .held { color: var(--muted); }
  .held b { color: var(--red); font-variant-numeric: tabular-nums; }
  .right { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .cv { color: var(--on-yellow); background: var(--yellow); text-decoration: none; padding: 3px 9px; font-weight: 700; }
  .mail { font: inherit; background: none; border: 0; color: var(--muted); cursor: pointer; padding: 0; }
  .mail:hover { color: var(--fg); }
  #theme-toggle { font: inherit; background: transparent; color: var(--muted); border: 1px solid var(--line); padding: 2px 8px; cursor: pointer; }
  @media (max-width: 560px) { .mail { display: none; } }
  .foot { border-top: 1px solid var(--line); padding-block: 28px 40px; }
  .foot-in { display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; font-size: 0.75rem; color: var(--muted); }
</style>
