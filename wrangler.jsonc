{
  // Static-assets-only Worker: serves the Astro build in ./dist
  // (copied from ./public plus generated pages) and applies the
  // security headers / CSP defined in public/_headers.
  "name": "tp9imka-dev",
  "compatibility_date": "2026-06-24",
  "build": { "command": "npm run build" },
  "routes": [
    { "pattern": "tp9imka.dev", "custom_domain": true },
    { "pattern": "www.tp9imka.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
